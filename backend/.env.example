# MySQL connection — copy to .env and adjust for your server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scratch_to_win

# API port
PORT=4000

# Admin OTP login: comma-separated 10-digit mobile numbers allowed to sign
# in to /admin, e.g. ADMIN_MOBILES=9876543210,9123456780
# Leave unset only for local demos — the admin then runs in open mode where
# any number can request a login code.
ADMIN_MOBILES=

# WhatsApp Business Cloud API (Meta). Leave blank to run in simulation mode —
# messages are logged to the console instead of being sent, so the demo works
# without real credentials. Fill these in for production delivery.
WHATSAPP_ACCESS_
WHATSAPP_PHONE_NUMBER_ID=1011932448680473
# Graph API version used for the send endpoint.
WHATSAPP_API_VERSION=v25.0
# Language code of the approved Meta template.
WHATSAPP_TEMPLATE_LANG=en_US
# Default country code prepended to 10-digit local numbers (India = 91).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Token Meta echoes back when verifying the webhook subscription.
WHATSAPP_VERIFY_TOKEN=scratch-verify

# Set to 0 to skip the dummy logo + sample customers/plays on a fresh install
SEED_DEMO_DATA=1
